VITE_REGISTRATION_MODE=open
VITE_EMAIL_CONFIRMATION_REQUIRED=true

# VAPID public key - safe to expose in frontend (begins with BN...)
VITE_VAPID_PUBLIC_KEY=

# Supabase Edge Functions / deployment secrets.
# Set these in Supabase Dashboard > Edge Functions > Secrets.
# NEVER put these in VITE_* variables - they would be exposed to the browser.
REGISTRATION_MODE=open
APP_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:[UZUPELNIJ_ADRES_EMAIL]
