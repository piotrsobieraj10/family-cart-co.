modules = ["web", "nodejs-22", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["javascript_database:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bun", "x", "vite", "preview", "--host", "0.0.0.0", "--port", "5000"]
build = ["bun", "run", "build"]

[userenv]

[userenv.shared]
VITE_REGISTRATION_MODE = "open"
VITE_EMAIL_CONFIRMATION_REQUIRED = "false"
APP_URL = ""
REGISTRATION_MODE = "open"
VITE_VAPID_PUBLIC_KEY = "BBN03ZKstKB-jeD-t7GmSWvzDh2PJEU08CkFeYRe0SIHzwqqZ2fnyN4EoUSfpQ2n4HltJrjcSx0DE3wM4qsMA5U"
NODE_ENV = "development"
